# Hostinger / Apache / LiteSpeed SPA & PWA configuration
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # Prevent search engine indexing on all routes
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

  # Ensure PWA service worker, manifest, and entry HTML stay fresh
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep existing static files and directories untouched
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite /api/* paths so client detects missing backend cleanly
  RewriteRule ^api(/|$) - [R=404,L]

  # SPA fallback for all frontend routes
  RewriteRule ^ index.html [L]
</IfModule>
