# Firebase Configuration (copy to .env and fill in your Firebase project values)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=project-al-barakah-store.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-al-barakah-store
VITE_FIREBASE_STORAGE_BUCKET=project-al-barakah-store.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Optional: leave empty or set to "(default)" for the default Firestore database
VITE_FIREBASE_DATABASE_ID=
